<script>
    // 1. 安全初始化 Live2D 看板娘
    try {
        if (typeof OML2D !== 'undefined') {
            OML2D.loadOml2d({
                parentElement: document.body,
                models: [
                    {
                        path: '/d/%E6%B5%8B%E8%AF%95%E5%86%85%E5%AE%B9/my-live2d-web/models/my_avatar/model.model3.json', 
                        position: [0, 80],     
                        scale: 0.11,              
                        stageStyle: { width: 350, height: 450 }
                    }
                ],
                tips: { style: { backgroundColor: 'rgba(0, 0, 0, 0.7)', textColor: '#fff' } }
            });
        }
    } catch(e) { console.warn("Live2D 载入发生异常：", e); }

    // 底栏检测定时器
    (function() {
        let retryCount = 0;
        const maxRetries = 50;
        const interval = setInterval(() => {
            retryCount++;
            if (document.querySelector(".footer") || retryCount >= maxRetries) {
                const customizeEl = document.querySelector("#customize");
                if (customizeEl) customizeEl.style.display = "";
                clearInterval(interval);
            }
        }, 200);
    })();

    // 动态网站运行时间计算
    function updateRuntime() {
        const XProgress = new Date("2026/06/01 10:00:00"); 
        const XToday = new Date();
        const diff = XToday - XProgress;
        
        if (diff < 0) {
            document.getElementById("runtime").innerHTML = "准备启航中...";
            return;
        }
        
        const XDaysRound = Math.floor(diff / 1000 / 60 / 60 / 24);
        const XHoursRound = Math.floor((diff / 1000 / 60 / 60) % 24);
        const XMinutesRound = Math.floor((diff / 1000 / 60) % 60);
        const XSecondsRound = Math.floor((diff / 1000) % 60);
        
        const runtimeEl = document.getElementById("runtime");
        // 移除了编辑判断，直接安全刷新时间
        if (runtimeEl) {
            runtimeEl.innerHTML = XDaysRound + " 天 " + XHoursRound + " 时 " + XMinutesRound + " 分 " + XSecondsRound + " 秒";
        }
    }
    setInterval(updateRuntime, 1000);

    // 智能时间段欢迎语
    (function() {
        const hour = new Date().getHours();
        let welcomeText = "欢迎光临本站！";
        if (hour < 6) { welcomeText = "🌟 个人熬夜伤身，早点休息哦！"; }
        else if (hour < 12) { welcomeText = "☀️ 早上好！新的一天充满活力！"; }
        else if (hour < 18) { welcomeText = "🌤️ 下午好！喝杯茶歇一歇吧！"; }
        else { welcomeText = "🌙 晚上好！享受舒适的静谧时光！"; }
        const welcomeEl = document.getElementById("welcome");
        if(welcomeEl) welcomeEl.innerHTML = welcomeText;
    })();

    // 渐变背景初始化
    if (document.getElementById('canvas-basic') && typeof Granim !== 'undefined') {
        var granimInstance = new Granim({
            element: '#canvas-basic',
            direction: 'left-right',
            isPausedWhenNotInView: true,
            states : {
                "default-state": {
                    gradients: [
                        ['#a18cd1', '#fbc2eb'],
                        ['#fff1eb', '#ace0f9'],
                        ['#d4fc79', '#96e6a1'],
                        ['#a1c4fd', '#c2e9fb'],
                        ['#a8edea', '#fed6e3'],
                        ['#9890e3', '#b1f4cf']
                    ]
                }
            }
        });
    }

    // 网页鼠标点击特效
    (function () {
        var a_idx = 0;
        window.onclick = function (event) {
            var a = ["❤富强❤", "❤民主❤", "❤文明❤", "❤和谐❤", "❤自由❤", "❤平等❤", "❤公正❤", "❤法治❤", "❤爱国❤", "❤敬业❤", "❤诚信❤", "❤友善❤"];
            var heart = document.createElement("b");
            heart.onselectstart = new Function('event.returnValue=false');

            document.body.appendChild(heart).innerHTML = a[a_idx];
            a_idx = (a_idx + 1) % a.length;
            heart.style.cssText = "position: fixed; left:-100%;";

            var f = 13,
                x = event.clientX - f / 2 - 30,
                y = event.clientY - f,
                c = randomColor(),
                opacity = 1,
                scale = 0.8;

            var timer = setInterval(function () {
                if (opacity <= 0) {
                    if(heart.parentNode) document.body.removeChild(heart);
                    clearInterval(timer);
                } else {
                    heart.style.cssText = "font-size:16px; cursor: default; position: fixed; color:" +
                        c + "; left:" + x + "px; top:" + y + "px; opacity:" + opacity + "; transform:scale(" +
                        scale + "); z-index: 99999;";
                    y--;
                    opacity -= 0.016;
                    scale += 0.002;
                }
            }, 15);
        };
        function randomColor() {
            return "rgb(" + (~~(Math.random() * 255)) + "," + (~~(Math.random() * 255)) + "," + (~~(Math.random() * 255)) + ")";
        }
    })();

