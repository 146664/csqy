        if (inputEl && !inputEl.dataset.bound) {
            inputEl.dataset.bound = "true";
            
            // 綁定輸入事件
            inputEl.addEventListener('input', handleSearchInput);
            
            // 綁定 Enter 鍵事件
            inputEl.addEventListener('keydown', function(event) {
                if (event.key === 'Enter' || event.keyCode === 13) { 
                    handleSearchSubmit(); 
                }
            });
            console.log("【系統提示】本地搜尋監聽器綁定成功！");
            return true;
        }
        return false;
    }

    // 核心 B：初始化音樂盒切換按鈕
    function tryBindMusic() {
        var btn1 = document.getElementById('playlist-btn-1');
        var btn2 = document.getElementById('playlist-btn-2');
        var toggleBtn = document.getElementById('music-toggle-btn');

        if (btn1 && btn2 && toggleBtn && !toggleBtn.dataset.bound) {
            toggleBtn.dataset.bound = "true";

            btn1.addEventListener('click', function() { switchPlaylist(0); });
            btn2.addEventListener('click', function() { switchPlaylist(1); });
            toggleBtn.addEventListener('click', toggleMusicBox);
            
            console.log("【系統提示】音樂盒控制按鈕綁定成功！");
            return true;
        }
        return false;
    }

