<script>
    var currentSearchMode = 'local'; 
    var lastObservedPath = '____INIT____'; 
    window.currentNoticeDirPath = ''; 
    var cachedAdminStatus = null; 

    function checkNoticeStatus() {
        var token = localStorage.getItem('alist-token') || localStorage.getItem('token');
        var hasAdminButton = document.querySelector('a[href="/@manage"]') || document.querySelector('a[href^="/@manage"]');
        var isAdmin = !!(token && hasAdminButton);
        cachedAdminStatus = isAdmin;

        var textSpan = document.getElementById('notice-text');
        if (textSpan) {
            var isEditable = textSpan.getAttribute('contenteditable') === 'true';
            if (isAdmin && !isEditable) {
                textSpan.setAttribute('contenteditable', 'true');
                textSpan.setAttribute('title', '点击可以直接修改公告内容');
            } else if (!isAdmin && isEditable) {
                textSpan.setAttribute('contenteditable', 'false');
            }
        }

        var folderTextSpan = document.getElementById('folder-notice-text');
        if (folderTextSpan) {
            var isFolderEditable = folderTextSpan.getAttribute('contenteditable') === 'true';
            if (isAdmin && !isFolderEditable) {
                folderTextSpan.setAttribute('contenteditable', 'true');
                folderTextSpan.setAttribute('title', '点击修改本目录说明，修改后请点击右侧保存');
                
                folderTextSpan.oninput = function() {
                    var saveBtn = document.getElementById('save-folder-notice-btn');
                    if(saveBtn) saveBtn.style.display = 'inline-block';
                };
            } else if (!isAdmin && isFolderEditable) {
                folderTextSpan.setAttribute('contenteditable', 'false');
            }
        }

        var currentPath = getCleanDirPath();
        if (currentPath !== lastObservedPath) {
            lastObservedPath = currentPath;
            window.currentNoticeDirPath = currentPath;
            loadFolderNotice(currentPath);
        }
    }

    async function loadFolderNotice(dirPath) {
        var box = document.getElementById('folder-spec-notice');
        var textSpan = document.getElementById('folder-notice-text');
        var saveBtn = document.getElementById('save-folder-notice-btn');
        if (!textSpan || !box) return;

        if (saveBtn) saveBtn.style.display = 'none';
        var token = localStorage.getItem('alist-token') || localStorage.getItem('token');
        var targetFile = dirPath.replace(/\/$/, "") + '/介绍.txt';

        try {
            let res = await fetch('/api/fs/get', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': token || '' },
                body: JSON.stringify({ path: targetFile })
            });
            let data = await res.json();
            if (data.code === 200 && data.data && data.data.raw_url) {
                let contentRes = await fetch(data.data.raw_url);
                let text = await contentRes.text();
                textSpan.innerText = text;
                box.style.display = 'flex';
            } else {
                if (cachedAdminStatus) {
                    textSpan.innerText = "【管理员提示】本层暂无说明，在此输入内容并点击右侧保存即可创建。";
                    box.style.display = 'flex';
                } else {
                    box.style.display = 'none';
                }
            }
        } catch (e) {
            console.error("读取层级介绍失败:", e);
            box.style.display = cachedAdminStatus ? 'flex' : 'none';
        }
    }

    async function handleSaveFolderNotice() {
        var token = localStorage.getItem('alist-token') || localStorage.getItem('token');
        if (!token) { alert("提示：请先登录管理员账号再进行此操作"); return; }

        var dirPath = window.currentNoticeDirPath;
        var text = document.getElementById('folder-notice-text').innerText.trim();
        var blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
        var targetFile = dirPath.replace(/\/$/, "") + '/介绍.txt';

        try {
            let res = await fetch('/api/fs/put', {
                method: 'PUT',
                headers: {
                    'Authorization': token,
                    'File-Path': encodeURIComponent(targetFile),
                    'As-Task': 'false'
                },
                body: blob
            });
            let data = await res.json();
            if (data.code === 200) {
                alert("💾 成功！本目录介绍已写入当前路径的 [介绍.txt] 中。");
                document.getElementById('save-folder-notice-btn').style.display = 'none';
            } else {
                alert("保存失败：" + data.message);
            }
        } catch (e) {
            alert("文件写入异常，请查看控制台日志");
            console.error(e);
        }
    }

    function getCleanDirPath() {
        let path = window.location.pathname;
        if (window.location.hash && window.location.hash.startsWith('#/')) {
            path = window.location.hash.split('?')[0].replace('#', '');
        }
        path = decodeURIComponent(path);
        if (path === '/' || path === '') return '/';
        
        const segments = path.split('/').filter(Boolean);
        if (segments.length > 0) {
            const lastSegment = segments[segments.length - 1];
            if (lastSegment.includes('.') && !path.endsWith('/')) {
                segments.pop();
                return '/' + segments.join('/');
            }
        }
        return '/' + segments.join('/');
    }

    function initNoticeObserver() {
        window.addEventListener('hashchange', checkNoticeStatus);
        var rootApp = document.getElementById('root') || document.body;
        var observer = new MutationObserver(function() {
            checkNoticeStatus();
        });
        observer.observe(rootApp, { childList: true, subtree: true });
        checkNoticeStatus();
    }

    function toggleSearchMode() {
        var btn = document.getElementById('search-mode-btn');
        var input = document.getElementById('local-search-input');
        if (currentSearchMode === 'local') {
            currentSearchMode = 'global';
            btn.innerText = '全盘模式';
            btn.classList.add('global-active');
            input.placeholder = "请点击下方搜索进行搜索"; 
        } else {
            currentSearchMode = 'local';
            btn.innerText = '本地模式';
            btn.classList.remove('global-active');
            input.placeholder = "在本文件进行搜索"; 
            localFuzzyFilter(""); 
        }
    }
    function fuzzyMatchAlgo(text, query) {
